var array<ShadowStudy> shadowStudies = array.new<ShadowStudy>()

// Cumulative research summary.
var int shadowCompleted = 0
var int shadowCurrentTargetFirst = 0
var int shadowAfter15To2 = 0
var int shadowAfter15To3 = 0
var int shadowAfter15To5 = 0
var int shadowAfter15To8 = 0
var float shadowSumDeltaB = 0.0
var float shadowSumDeltaC = 0.0
var float shadowSumDeltaD = 0.0
var int shadowComparableB = 0
var int shadowComparableC = 0
var int shadowComparableD = 0
var string lastShadowSummary = "No completed shadow study yet"

// v1.3.4 research-persistence aggregates. These never feed live predicates.
var int shadowDayAnchors = 0
var int shadowDayCompleted = 0
var int shadowDayFirstEntries = 0
var int shadowDayReentries = 0
var int shadowDayStopAHits = 0
var int shadowDayStopBHits = 0
var int shadowDayStopASurvivedB = 0
var int shadowDayATargetFirst = 0
