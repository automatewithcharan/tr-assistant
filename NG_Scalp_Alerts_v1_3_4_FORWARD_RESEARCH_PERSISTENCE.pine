//@version=6
indicator("NG Scalp Alerts v1.3.4 - Forward Research Persistence", shorttitle="NGScalp1.3.4Research", overlay=true, max_labels_count=500)

// Research-only extension of NG Scalp Alerts v1.1 / v1.2 shadow study.
// LIVE BUY/SELL/STOP/TARGET logic and live sizing inputs are intentionally preserved.
// v1.3.4 preserves v1.3.3 live behavior and adds durable research-only telemetry.
// BUY decisions: confirmed 1m bars only. STOP/TARGET monitoring: realtime.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
grpMode = "1. Operating mode"
operatingMode = input.string(
    "LIVE ALERTS",
    "Mode",
    options=["LIVE ALERTS", "HISTORICAL SIMULATION"],
    group=grpMode
)

grpTrigger = "2. Momentum trigger"
supertrendAtrLen = input.int(10, "Supertrend ATR length", minval=2, maxval=50, group=grpTrigger)
supertrendFactor = input.float(3.0, "Supertrend factor", minval=0.5, maxval=10.0, step=0.1, group=grpTrigger)
triggerMode = input.string(
    "Flip or breakout",
    "Trigger",
    options=["Supertrend flip", "Breakout while bullish", "Flip or breakout"],
    group=grpTrigger
)
breakoutLookback = input.int(4, "Breakout lookback (1m bars)", minval=2, maxval=20, group=grpTrigger)
requireStrongClose = input.bool(false, "Require strong close quality", group=grpTrigger)
minClosePosition = input.float(0.75, "Strong-close minimum position", minval=0.50, maxval=0.95, step=0.05, group=grpTrigger)

grpTrend = "3. Trend / safety"
requireVwap = input.bool(true, "Require close above session VWAP", group=grpTrend)
oneMinuteAtrLen = input.int(14, "1m ATR length", minval=5, maxval=50, group=grpTrend)
heavyRedBodyAtr = input.float(0.80, "Previous heavy-red body (ATR)", minval=0.20, maxval=2.0, step=0.10, group=grpTrend)
heavyRedVolumeRatio = input.float(1.80, "Previous heavy-red volume ratio", minval=1.0, maxval=5.0, step=0.10, group=grpTrend)
fiveMinuteRedBodyAtr = input.float(0.60, "Completed 5m red body (5m ATR)", minval=0.20, maxval=2.0, step=0.10, group=grpTrend)
maxSignalRangeAtr = input.float(2.00, "Anti-chase maximum signal-bar range (ATR)", minval=0.50, maxval=4.0, step=0.10, group=grpTrend)

grpRisk = "4. Risk / target"
riskBudget = input.float(500.0, "Planned risk per trade (₹)", minval=50.0, step=50.0, group=grpRisk)
maxExposure = input.float(300000.0, "Maximum notional exposure (₹)", minval=10000.0, step=25000.0, group=grpRisk)
stopBufferAtr = input.float(0.10, "Stop below signal low (ATR)", minval=0.0, maxval=0.50, step=0.05, group=grpRisk)
minStopAtr = input.float(0.35, "Minimum stop distance (ATR)", minval=0.10, maxval=1.00, step=0.05, group=grpRisk)
targetR = input.float(1.50, "Target (R)", minval=0.50, maxval=4.0, step=0.10, group=grpRisk)

grpCosts = "5. Groww cost viability"
requireCostViability = input.bool(true, "Require Groww cost viability", group=grpCosts)
costCoverageK = input.float(1.00, "Minimum gross / estimated Groww cost", minval=0.50, maxval=3.0, step=0.05, group=grpCosts)
slippageTicks = input.int(1, "Estimated adverse slippage ticks per leg", minval=0, maxval=10, group=grpCosts)

grpTime = "6. Session / trade control"
entryStartHour = input.int(9, "Entry start hour IST", minval=9, maxval=15, group=grpTime)
entryStartMinute = input.int(20, "Entry start minute IST", minval=0, maxval=59, group=grpTime)
entryCutoffHour = input.int(14, "Entry cutoff hour IST", minval=9, maxval=15, group=grpTime)
entryCutoffMinute = input.int(50, "Entry cutoff minute IST", minval=0, maxval=59, group=grpTime)
forceExitHour = input.int(15, "Force-exit hour IST", minval=14, maxval=15, group=grpTime)
forceExitMinute = input.int(15, "Force-exit minute IST", minval=0, maxval=29, group=grpTime)
cooldownBars = input.int(2, "Cooldown bars after SELL", minval=0, maxval=20, group=grpTime)
maxTradesPerDay = input.int(6, "Maximum BUY alerts per stock/day", minval=1, maxval=20, group=grpTime)
exitOnBearishSupertrend = input.bool(true, "SELL on confirmed bearish Supertrend flip", group=grpTime)

grpDisplay = "7. Display"
showDashboard = input.bool(true, "Show WAIT / BUY / HOLD / SELL dashboard", group=grpDisplay)
showSignalLabels = input.bool(true, "Show BUY / SELL labels", group=grpDisplay)
showSupertrend = input.bool(true, "Show Supertrend", group=grpDisplay)
showVwap = input.bool(true, "Show VWAP", group=grpDisplay)

// Permanent TradingView-compatible date strings retained for diagnostics/version safety.
grpDebug = "8. Optional historical window"
debugWindowStart = input.time(timestamp("10 Aug 2026 00:00 +0530"), "Reference start", group=grpDebug)
debugWindowEnd = input.time(timestamp("19 Sep 2026 00:00 +0530"), "Reference end", group=grpDebug)

grpResearch = "9. Shadow research (NO live behavior changes)"
shadowResearchEnabled = input.bool(true, "Enable A/B/C/D shadow exit study", group=grpResearch)
showResearchDashboard = input.bool(true, "Show shadow research dashboard", group=grpResearch)
emitResearchSummaryAlert = input.bool(false, "Send EOD shadow summary alert", group=grpResearch)
emitShadowResultAlert = input.bool(true, "Send one SHADOW_RESULT per completed anchor", group=grpResearch)

// Frozen EXIT_SHADOW_v1 parameters. Do not tune within the forward cohort.
// v1.3 research fixes: causal runner-MFE accounting, B/C pre-partial exit parity,
// next-session shadow finalization, richer timing/liquidity telemetry, per-trade EOD export.
float SHADOW_B_PARTIAL_R = 1.50
float SHADOW_C_PARTIAL_R = 2.00
int SHADOW_STOP_B_LOOKBACK = 3
float SHADOW_STOP_B_BUFFER_ATR = 0.15
float SHADOW_REFERENCE_ACCOUNT = 500000.0
float SHADOW_REFERENCE_ALLOCATION_PCT = 0.15

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
fmtPrice(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

fmtMoney(float value) =>
    na(value) ? "—" : "₹" + str.tostring(value, "#.##")

fmtRatio(float value) =>
    na(value) ? "—" : str.tostring(value, "#.##") + "x"

fmtR(float value) =>
    na(value) ? "—" : str.tostring(value, "#.##") + "R"

fmtValue(float value) =>
    na(value) ? "NA" : str.tostring(value, "#.####")

fmtTime(int value) =>
    na(value) ? "NA" : str.format_time(value, "yyyy-MM-dd'T'HH:mm:ss", "Asia/Kolkata") + "+05:30"

fmtDate(int value) =>
    na(value) ? "NA" : str.format_time(value, "yyyy-MM-dd", "Asia/Kolkata")

yn(bool value) =>
    value ? "Y" : "N"

countBullExpansion(float atrSeries) =>
    int count = 0
    bool contiguous = true
    for offset = 0 to 4
        bool expansion = close[offset] > open[offset] and not na(atrSeries[offset]) and high[offset] - low[offset] >= atrSeries[offset]
        if contiguous and expansion
            count += 1
        else
            contiguous := false
    count

shadowReasonExact(string reason) =>
    not str.contains(reason, "FALLBACK") and not str.contains(reason, "AMBIGUOUS")

entryWindowOpen(int ts) =>
    int hh = hour(ts, "Asia/Kolkata")
    int mm = minute(ts, "Asia/Kolkata")
    bool afterStart = hh > entryStartHour or (hh == entryStartHour and mm >= entryStartMinute)
    bool beforeCutoff = hh < entryCutoffHour or (hh == entryCutoffHour and mm < entryCutoffMinute)
    afterStart and beforeCutoff

forceExitNow(int ts) =>
    int hh = hour(ts, "Asia/Kolkata")
    int mm = minute(ts, "Asia/Kolkata")
    hh > forceExitHour or (hh == forceExitHour and mm >= forceExitMinute)

calcQty(float entryValue, float stopValue) =>
    float riskPerShareValue = entryValue - stopValue
    float byRisk = riskPerShareValue > 0 ? math.floor(riskBudget / riskPerShareValue) : 0.0
    float byExposure = entryValue > 0 ? math.floor(maxExposure / entryValue) : 0.0
    int(math.max(math.min(byRisk, byExposure), 0.0))

growBrokerage(float notionalValue) =>
    float base = math.min(20.0, notionalValue * 0.001)
    base < 5.0 ? math.min(5.0, notionalValue * 0.025) : base

growwRoundTripCost(float entryValue, float exitValue, int qtyValue, int slipTicks) =>
    // NSE cash-market split effective 01-Mar-2026: transaction charge ₹306.99/crore
    // + IPFT ₹0.01/crore = ₹307/crore each side. Total outflow is unchanged
    // versus the older ₹297 + ₹10 split, but the components below are current.
    float qtyFloat = float(qtyValue)
    float entryNotional = entryValue * qtyFloat
    float exitNotional = exitValue * qtyFloat
    float brokerageEntry = growBrokerage(entryNotional)
    float brokerageExit = growBrokerage(exitNotional)
    float stampDuty = entryNotional * 0.00003
    float stt = exitNotional * 0.00025
    float exchangeCharges = (entryNotional + exitNotional) * 0.000030699
    float sebiCharges = (entryNotional + exitNotional) * 0.000001
    float ipftCharges = (entryNotional + exitNotional) * 0.000000001
    float gstBase = brokerageEntry + brokerageExit + exchangeCharges + sebiCharges + ipftCharges
    float gst = gstBase * 0.18
    float chargesExSlippage = brokerageEntry + brokerageExit + stampDuty + stt + exchangeCharges + sebiCharges + ipftCharges + gst
    float modeledSlippage = 2.0 * float(slipTicks) * syminfo.mintick * qtyFloat
    float totalCost = chargesExSlippage + modeledSlippage
    [chargesExSlippage, modeledSlippage, totalCost]

// Research-only per-order cost. It intentionally mirrors the current live Groww model
// so shadow models differ by execution legs, not by a new fee assumption.
shadowLegCost(float priceValue, int qtyValue, bool isBuy, int slipTicks) =>
    float qtyFloat = float(qtyValue)
    float notional = priceValue * qtyFloat
    float brokerage = growBrokerage(notional)
    float stampDuty = isBuy ? notional * 0.00003 : 0.0
    float stt = isBuy ? 0.0 : notional * 0.00025
    float exchangeCharges = notional * 0.000030699
    float sebiCharges = notional * 0.000001
    float ipftCharges = notional * 0.000000001
    float gstBase = brokerage + exchangeCharges + sebiCharges + ipftCharges
    float gst = gstBase * 0.18
    float modeledSlippage = float(slipTicks) * syminfo.mintick * qtyFloat
    brokerage + stampDuty + stt + exchangeCharges + sebiCharges + ipftCharges + gst + modeledSlippage

// ─────────────────────────────────────────────────────────────────────────────
// Core data
// ─────────────────────────────────────────────────────────────────────────────
bool isOneMinute = timeframe.isminutes and timeframe.multiplier == 1
float atr1 = ta.atr(oneMinuteAtrLen)
float sessionVwap = ta.vwap(hlc3)
[supertrendLine, supertrendDirection] = ta.supertrend(supertrendFactor, supertrendAtrLen)

bool supertrendBullish = supertrendDirection < 0
bool bullishFlip = ta.change(supertrendDirection) < 0
bool bearishFlip = ta.change(supertrendDirection) > 0

float recentBreakoutHigh = ta.highest(high[1], breakoutLookback)
bool freshBreakout = not na(recentBreakoutHigh) and close > recentBreakoutHigh

float candleRange = high - low
float closePosition = candleRange > 0 ? (close - low) / candleRange : 0.0
float signalRangeAtr = not na(atr1) and atr1 > 0 ? candleRange / atr1 : na

bool triggerEvent = (
    triggerMode == "Supertrend flip" ? bullishFlip :
    triggerMode == "Breakout while bullish" ? (supertrendBullish and freshBreakout) :
    (bullishFlip or (supertrendBullish and freshBreakout))
)

bool candleQualityOk = close > open and (not requireStrongClose or closePosition >= minClosePosition)
bool trendOk = not requireVwap or (not na(sessionVwap) and close >= sessionVwap)
bool antiChaseOk = not na(signalRangeAtr) and signalRangeAtr <= maxSignalRangeAtr

float avgVolume = ta.sma(volume[1], 20)
float medianVolume20 = ta.median(volume[1], 20)
float avgTurnover = ta.sma(close[1] * volume[1], 20)
float previousRedBody = open[1] - close[1]
float previousVolumeRatio = not na(avgVolume[1]) and avgVolume[1] > 0 ? volume[1] / avgVolume[1] : na
bool heavyRedImpulse = close[1] < open[1] and not na(atr1[1]) and previousRedBody >= atr1[1] * heavyRedBodyAtr and not na(previousVolumeRatio) and previousVolumeRatio >= heavyRedVolumeRatio

[ctxOpen5, ctxClose5, ctxAtr5, ctxEma5, ctxEma5Prev, ctxVol5, ctxTimeClose5] = request.security(
    syminfo.tickerid,
    "5",
    [open[1], close[1], ta.atr(14)[1], ta.ema(close, 20)[1], ta.ema(close, 20)[2], volume[1], time_close[1]],
    gaps=barmerge.gaps_off,
    lookahead=barmerge.lookahead_on
)

bool newCompleted5m = ta.change(ctxTimeClose5) != 0
float ctxRedBody = not na(ctxOpen5) and not na(ctxClose5) ? ctxOpen5 - ctxClose5 : na
bool bearish5mContext = (
    not na(ctxRedBody) and
    not na(ctxAtr5) and
    not na(ctxEma5) and
    not na(ctxEma5Prev) and
    ctxClose5 < ctxOpen5 and
    ctxRedBody >= ctxAtr5 * fiveMinuteRedBodyAtr and
    ctxClose5 < ctxEma5 and
    ctxEma5 < ctxEma5Prev
)

bool fallingKnife = heavyRedImpulse or bearish5mContext
float shadowStructuralLow3 = ta.lowest(low, SHADOW_STOP_B_LOOKBACK)

// ─────────────────────────────────────────────────────────────────────────────
// Gate telemetry (Pine-native only; scanner/Discord time is intentionally absent)
// ─────────────────────────────────────────────────────────────────────────────
var int gateFirstTriggerTime = na
var int gateTriggerAttempts = 0
var int gateBlockCandle = 0
var int gateBlockTrend = 0
var int gateBlockKnife = 0
var int gateBlockChase = 0
var int gateBlockStop = 0
var int gateBlockQty = 0
var int gateBlockEconomics = 0
var string gateLastBlock = "NONE"

