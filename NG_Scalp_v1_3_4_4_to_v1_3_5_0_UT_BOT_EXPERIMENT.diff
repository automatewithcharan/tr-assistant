+// Faithful Pine-v6 port of the supplied UT Bot v4 recursive trailing stop.
+// Every UT signal is calculated on the chart's one-minute series only.
+float utAtr = ta.atr(utAtrPeriod)
+float utLoss = utKeyValue * utAtr
+float utTrail = 0.0
+float utPreviousTrail = nz(utTrail[1], 0.0)
+utTrail := close > utPreviousTrail and close[1] > utPreviousTrail ? math.max(utPreviousTrail, close - utLoss) : close < utPreviousTrail and close[1] < utPreviousTrail ? math.min(utPreviousTrail, close + utLoss) : close > utPreviousTrail ? close - utLoss : close + utLoss
+
+int utPosition = 0
+utPosition := close[1] < utPreviousTrail and close > utPreviousTrail ? 1 : close[1] > utPreviousTrail and close < utPreviousTrail ? -1 : nz(utPosition[1], 0)
+
+// Evaluate crossover functions on every calculation; confirmation alone gates use.
+bool utBuyCross = ta.crossover(close, utTrail)
+bool utSellCross = ta.crossunder(close, utTrail)
+bool utFreshBuyConfirmed = barstate.isconfirmed and utBuyCross
+bool utFreshSellConfirmed = barstate.isconfirmed and utSellCross
+bool utBullish = close > utTrail
+bool utBearish = close < utTrail
+int utBarsSinceConfirmedBuy = ta.barssince(utFreshBuyConfirmed)
+int utLastConfirmedBuyTime = ta.valuewhen(utFreshBuyConfirmed, time_close, 0)
+
