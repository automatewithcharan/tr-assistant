[Unit]
Description=NG raw-market observation and Top100 WATCH publisher
After=network-online.target

[Service]
Type=simple
User=charan_sai
WorkingDirectory=/home/charan_sai/tr-assistant
EnvironmentFile=/home/charan_sai/tr-assistant/.env.dev
Environment=TZ=Asia/Kolkata
ExecStart=/home/charan_sai/tr-assistant/.venv/bin/python /home/charan_sai/tr-assistant/scripts/ng_nse_top_gainers_watch.py --state-root /home/charan_sai/tr-assistant/results/Data/ng_nse_top_gainers_watch --poll-seconds 15
Restart=on-failure
RestartSec=15
