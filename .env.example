KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8000/

# Fail-closed execution defaults. Repository launchers enforce these values.
# No strategy is authorized for real orders by this repository configuration.
KITE_EXECUTION_MODE=paper
KITE_DRY_RUN=1
KITE_AUTO_TRADE=0
KITE_AUTO_BUY=0
KITE_AUTO_SELL=0
SIGNALMONITOR_AUTOTRADE_ENABLED=0
SIGNALMONITOR_AUTOTRADE_OBSERVATION_ENABLED=0
SIGNALMONITOR_AUTOTRADE_REAL_ORDERS=0
KITE_LIVE_ACKNOWLEDGEMENT=
# Both lists are mandatory for live mutations. Identifiers must be exact,
# lowercase, comma-separated canonical values with no whitespace or duplicates.
KITE_LIVE_CALLER_ALLOWLIST=
KITE_LIVE_STRATEGY_ALLOWLIST=
KITE_RISK_ACCOUNT=main
KITE_RISK_EVIDENCE_SOURCE=live_portfolio
KITE_RISK_EVIDENCE_MAX_AGE_SECONDS=900
KITE_MARKET_DATA_MAX_AGE_SECONDS=60
KITE_AMBIGUOUS_RECONCILE_ATTEMPTS=5
KITE_AMBIGUOUS_RECONCILE_INTERVAL_SECONDS=1.0

DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_USER_ID=
DISCORD_CHANNEL_ID=

PKSCREENER_SKIP_LOGIN=1
SUBSCRIPTION_ENABLED=0

CHARAN_EST_BUY_COST_PCT=0.00118
CHARAN_EST_SELL_COST_PCT=0.00104
# Zero/missing limits do not make live entries safe: evidence is still mandatory.
ASSISTANT_MAX_DAILY_LOSS=0
ASSISTANT_MAX_CONSECUTIVE_LOSSES=0
ASSISTANT_OPENING_FAST_LANE_TOP_N=4
ASSISTANT_EARLY_RADAR_MIN_CHANGE=1.0
ASSISTANT_EARLY_RADAR_MAX_CHANGE=4.5
ASSISTANT_EARLY_RADAR_MIN_TURNOVER_CR=0.75
ASSISTANT_EARLY_RADAR_MIN_IMBALANCE=1.4
ASSISTANT_EARLY_RADAR_INTERVAL_SEC=180
ASSISTANT_EARLY_RADAR_MAX_LINES=8
ASSISTANT_RESCAN_MIN_DAY_CHANGE=1.0
ASSISTANT_EARLY_ENGINE_MIN_CHANGE=1.0
ASSISTANT_EARLY_ENGINE_MAX_CHANGE=4.5
ASSISTANT_EARLY_ENGINE_MIN_PRICE=20
ASSISTANT_EARLY_ENGINE_MIN_RR=1.5
ASSISTANT_EARLY_ENGINE_MAX_GAP=0.5
ASSISTANT_EARLY_ENGINE_MIN_SCORE=50
ASSISTANT_EARLY_ENGINE_MIN_CONFIDENCE=20
ASSISTANT_EARLY_ENGINE_MIN_VOL_RATIO=3.0
ASSISTANT_EARLY_ENGINE_END=10:45
SIGNALMONITOR_ENABLE_LIVE_FEATURE_RECORDER=1
SIGNALMONITOR_STANDALONE_EVIDENCE=1
SIGNALMONITOR_STANDALONE_EVIDENCE_POLL_SECONDS=5
SIGNALMONITOR_LIVE_FEATURE_INTERVAL_SECONDS=15

KITE_MAX_ORDER_VALUE=25000
KITE_MAX_OPEN_POSITIONS=0
KITE_MAX_DAILY_ORDERS=12
KITE_PRODUCT_TYPE=MIS
KITE_TIME_SLICED_CAPITAL=1
KITE_SWING_CAPITAL=65000
KITE_SWING_MAX_ORDER_VALUE=25000
KITE_SWING_MAX_OPEN_POSITIONS=3
KITE_INTRADAY_CAPITAL=25000
KITE_INTRADAY_MAX_ORDER_VALUE=15000
KITE_INTRADAY_MAX_OPEN_POSITIONS=2
ASSISTANT_INTRADAY_AUTO_BUY_CUTOFF=11:30
ASSISTANT_LATE_COMER_START=10:30
