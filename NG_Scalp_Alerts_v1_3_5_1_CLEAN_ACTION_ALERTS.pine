// Ordinary UDT/array fields roll back between realtime executions. These
// primitive varip latches persist intrabar, so alert.freq_all can preserve
// distinct anchors without re-emitting the same TradeId on the same close.
varip array<string> shadowResultEmittedTradeIds = array.new<string>()
varip int shadowResultDedupeDayKey = na
varip int shadowEodEmittedDayKey = na

// ─────────────────────────────────────────────────────────────────────────────
// Virtual live trade state — unchanged from v1.1
// ─────────────────────────────────────────────────────────────────────────────
var bool engineInitialized = false
var bool tradeActive = false

var float tradeEntry = na
var float tradeStop = na
var float tradeTarget = na
var float tradeRiskPerShare = na
